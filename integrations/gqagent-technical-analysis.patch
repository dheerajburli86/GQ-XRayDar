+
+const personalTools = [
+  {
+    name: "ta_alerts",
+    description: `The asker's alerts in the GQ Technical Analysis app; fired alerts are sent to them on Telegram. Actions: list, add, pause, resume, delete, pause_all, resume_all, recent (alerts that fired). To add, give rule + params + timeframe (D daily, W weekly, M monthly) + either a symbol or one of their watchlists. Rules: ${RULE_HELP}. Examples: 'alert me when TCS weekly RSI crosses above 60' -> rule rsi_cross_above, params {level:60}, timeframe W, symbol TCS. 'tell me when anything in my Core list makes a golden cross' -> golden_cross, watchlist Core. Confirm what was set in one sentence.`,
+    parameters: {
+      type: "object",
+      properties: {
+        action: { type: "string", enum: ["list", "add", "pause", "resume", "delete", "pause_all", "resume_all", "recent"] },
+        rule: { type: "string" }, params: { type: "object" }, timeframe: { type: "string", enum: TFS },
+        symbol: { type: "string" }, watchlist: { type: "string" },
+        id: { type: "string", description: "alert id from list, for pause/resume/delete" },
+      },
+      required: ["action"],
+    },
+    async run(a, ctx) {
+      switch (a.action) {
+        case "list": return call(ctx, "GET", "/api/alerts/rules");
+        case "recent": return call(ctx, "GET", "/api/alerts/events?limit=30");
+        case "add":
+          if (!a.rule) return { error: "which rule? " + RULE_HELP };
+          if (!a.symbol && !a.watchlist) return { error: "give a symbol or a watchlist" };
+          return call(ctx, "POST", "/api/alerts/rules", { rule: a.rule, params: a.params || {}, tf: a.timeframe || "D", instrument: a.symbol, watchlist: a.watchlist, source: "telegram" });
+        case "pause": case "resume":
+          if (!a.id) return { error: "which alert? list them first" };
+          return call(ctx, "PATCH", `/api/alerts/rules/${encodeURIComponent(a.id)}`, { enabled: a.action === "resume" });
+        case "delete":
+          if (!a.id) return { error: "which alert? list them first" };
+          return call(ctx, "DELETE", `/api/alerts/rules/${encodeURIComponent(a.id)}`);
+        case "pause_all": case "resume_all":
+          return call(ctx, "POST", "/api/alerts/pause", { paused: a.action === "pause_all" });
+        default: return { error: "unknown action" };
+      }
+    },
+  },
+  {
+    name: "ta_watchlist",
+    description: "The asker's OWN watchlists inside the GQ Technical Analysis app (not the team lists, not the heatmap website). Actions: list, create, add, remove, delete. Symbols can be tickers or names; if a symbol is ambiguous the result lists candidates, so ask which one.",
+    parameters: { type: "object", properties: { action: { type: "string", enum: ["list", "create", "add", "remove", "delete"] }, watchlist: { type: "string" }, symbols: { type: "array", items: { type: "string" } } }, required: ["action"] },
+    run(a, ctx) {
+      if (a.action === "list") return call(ctx, "GET", "/api/watchlists");
+      if (!a.watchlist) return Promise.resolve({ error: "which watchlist?" });
+      return call(ctx, "POST", "/api/watchlists", { action: a.action, watchlist: a.watchlist, symbols: a.symbols || [] });
+    },
+  },
+  {
+    name: "ta_tasks",
+    description: "Background jobs in the Technical Analysis app that report back on Telegram. Actions: list, create, pause, resume, run, delete. Kinds: review_list {watchlist} (which names in a list are rising), screen {query}, summary {scope}, compare {a, b}, analyze {symbol}. schedule (IST): 'daily HH:MM', 'weekdays HH:MM' or 'weekly mon HH:MM'; leave it empty to run once now. Example: 'every weekday at 8:45 tell me which stocks in my Core list are rising' -> create, kind review_list, params {watchlist:'Core'}, schedule 'weekdays 08:45'.",
+    parameters: { type: "object", properties: { action: { type: "string", enum: ["list", "create", "pause", "resume", "run", "delete"] }, kind: { type: "string", enum: ["review_list", "screen", "summary", "compare", "analyze"] }, title: { type: "string" }, params: { type: "object" }, schedule: { type: "string" }, id: { type: "string" } }, required: ["action"] },
+    run(a, ctx) {
+      switch (a.action) {
+        case "list": return call(ctx, "GET", "/api/tasks");
+        case "create": return call(ctx, "POST", "/api/tasks", { kind: a.kind, title: a.title, params: a.params || {}, schedule: a.schedule || null });
+        case "pause": return call(ctx, "PATCH", `/api/tasks/${encodeURIComponent(a.id)}`, { status: "paused" });
+        case "resume": return call(ctx, "PATCH", `/api/tasks/${encodeURIComponent(a.id)}`, { status: "pending" });
+        case "run": return call(ctx, "PATCH", `/api/tasks/${encodeURIComponent(a.id)}`, { runNow: true });
+        case "delete": return call(ctx, "DELETE", `/api/tasks/${encodeURIComponent(a.id)}`);
+        default: return Promise.resolve({ error: "unknown action" });
+      }
+    },
+  },
+];
+
+/** personal: live conversations only (never in the bot's own scheduled runs). */
+function makeTools({ personal = true } = {}) { return [...readTools, ...(personal ? personalTools : [])]; }
+
+/** /ta link <code>: connects this Telegram account to a Technical Analysis login. */
+async function link(ta, { code, telegramUserId, chatId, name }, fetchImpl = fetch) {
+  const r = await call({ ta, fetch: fetchImpl, taTelegramUser: String(telegramUserId) }, "POST", "/api/telegram/link", { code, telegramUserId: String(telegramUserId), chatId: String(chatId), name });
+  return r;
+}
+async function unlink(ta, telegramUserId, fetchImpl = fetch) {
+  return call({ ta, fetch: fetchImpl, taTelegramUser: String(telegramUserId) }, "POST", "/api/telegram/unlink");
+}
+
+module.exports = { makeTools, link, unlink, call, readTools, personalTools };
