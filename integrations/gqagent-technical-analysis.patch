@@ -0,0 +1,43 @@
+"use strict";
+// The GQ Technical Analysis web app's agent panel talks to THIS agent through
+// POST /api/chat (see server.js), so the website and Telegram share one model,
+// one prompt and one tool set. The TA server calls it with TA_API_SECRET and
+// says who is asking (their app login, and their Telegram id when linked).
+const crypto = require("crypto");
+const { runWithEngines } = require("./engines");
+const { buildTools } = require("./tools/index");
+const { buildSystemPrompt } = require("./prompt");
+
+function secretOk(cfg, got) {
+  const a = Buffer.from(String(got || "")), b = Buffer.from(String(cfg.taApiSecret || ""));
+  return b.length > 0 && a.length === b.length && crypto.timingSafeEqual(a, b);
+}
+
+async function answerWeb({ cfg, engines, store, researchTool, log = console.log }, body) {
+  const user = body.user || {};
+  const label = user.name || user.email || "a Technical Analysis user";
+  const userId = `ta:${String(user.email || "unknown").toLowerCase()}`;
+  const page = body.context && typeof body.context === "object"
+    ? `\n\nThe person is looking at this page of the Technical Analysis app: ${JSON.stringify(body.context).slice(0, 1500)}. "This stock", "this chart" and "here" refer to it.`
+    : "";
+  const ctx = {
+    fetch, projectsUsed: new Set(), usage: { in: 0, out: 0 }, selected: [], attachments: [], lists: store,
+    user: { id: userId, label },
+    ta: { url: cfg.taApiUrl, secret: cfg.taApiSecret, appUrl: cfg.taAppUrl },
+    taTelegramUser: user.telegramUserId ? String(user.telegramUserId) : null,
+    audit: async ({ tool, ok, ms }) => log(`[tool] user=${userId} tool=${tool} ok=${ok} ms=${ms}`),
+  };
+  const history = Array.isArray(body.history) ? body.history.filter((h) => h && (h.role === "user" || h.role === "assistant") && typeof h.content === "string").slice(-10).map((h) => ({ role: h.role, content: h.content.slice(0, 4000) })) : [];
+  const out = await runWithEngines({
+    mode: "default", engines, researchTool,
+    buildTools: (research) => buildTools({ selected: [], user: { isAdmin: false }, attached: [], liveOn: false, researchTool: research, taskTools: false, projectDbs: null, busybeeActions: false, writeActions: !!ctx.taTelegramUser, taOn: true }),
+    buildSystem: (toolNames) => buildSystemPrompt({ user: { label }, selected: [], attached: [], toolNames, telegram: false }) + page,
+    ctx, history, message: String(body.message || "").slice(0, 4000),
+    maxSteps: cfg.maxSteps, deadline: Date.now() + Math.min(cfg.requestDeadlineMs, 160000),
+    checkBudget: () => store.check(userId, cfg, new Date()),
+  });
+  if (ctx.usage.in || ctx.usage.out) store.record(userId, ctx.usage.in, ctx.usage.out, new Date());
+  return { answer: out.answer };
+}
+
+module.exports = { answerWeb, secretOk };
