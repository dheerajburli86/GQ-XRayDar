+const { answerWeb, secretOk } = require("./src/webchat");
+async function webChat(req, res) {
+  const reply = (status, body) => { res.writeHead(status, { "content-type": "application/json", "cache-control": "no-store" }); res.end(JSON.stringify(body)); };
+  if (!cfg.taApiSecret || !cfg.taApiUrl) return reply(404, { error: "the Technical Analysis connection is not configured" });
+  if (!secretOk(cfg, req.headers["x-ta-secret"])) return reply(401, { error: "wrong secret" });
+  if (!provider) return reply(503, { error: "the agent's model is not configured (DEEPINFRA_API_KEY)" });
+  let raw = "";
+  for await (const c of req) { raw += c; if (raw.length > 200000) return reply(413, { error: "too large" }); }
+  let body;
+  try { body = JSON.parse(raw || "{}"); } catch { return reply(400, { error: "invalid JSON" }); }
