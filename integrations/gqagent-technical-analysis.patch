+  {
+    name: "ta_screen",
+    description: "Run a technical screen over the whole universe (India, US, global stocks, ETFs and indices) and return matches. Write the query in plain English, e.g. 'India stocks weekly MMA bullish and RSC vs country rising', 'US large caps at 52 week high on volume', 'Japan stocks in a weekly MMA squeeze', 'top 20 by score in Financials'. Returns what it understood, the total and the top results with a link.",
+    parameters: { type: "object", properties: { query: { type: "string" }, limit: { type: "number", description: "default 25, max 100" } }, required: ["query"] },
+    run: (a, ctx) => call(ctx, "POST", "/api/screen", { query: a.query, limit: a.limit || 25 }),
+  },
+  {
+    name: "ta_compare",
+    description: "Side-by-side technical comparison of two instruments (returns, MMA, RSI, relative strength, stage, distance from high, score, fundamentals).",
+    parameters: { type: "object", properties: { a: { type: "string" }, b: { type: "string" } }, required: ["a", "b"] },
+    run: (a, ctx) => call(ctx, "GET", `/api/compare?${qs({ a: a.a, b: a.b })}`),
