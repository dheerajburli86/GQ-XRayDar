+/** GQ Technical Analysis integration: tools, /ta link, web chat auth. No network. */
+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+const technical = require("../src/tools/technical.js");
+const { buildTools } = require("../src/tools/index.js");
+const { buildSystemPrompt } = require("../src/prompt.js");
+const { secretOk } = require("../src/webchat.js");
+const cfgMod = require("../src/config.js");
+
+const ok = (j, status = 200) => new Response(JSON.stringify(j), { status, headers: { "content-type": "application/json" } });
+
+test("config reads TA_API_URL / TA_API_SECRET / TA_APP_URL", () => {
+  const c = cfgMod.load({ TA_API_URL: "https://ta.example/", TA_API_SECRET: "s", TA_APP_URL: "https://app.example/" });
+  assert.equal(c.taApiUrl, "https://ta.example");
+  assert.equal(c.taApiSecret, "s");
+  assert.equal(c.taAppUrl, "https://app.example");
+});
+
+test("ta tools are declared only when TA is on; personal tools only in live chats", () => {
+  const names = (o) => buildTools({ selected: [], ...o }).map((t) => t.name);
+  assert.ok(!names({}).some((n) => n.startsWith("ta_")));
+  const live = names({ taOn: true, writeActions: true });
+  for (const n of ["ta_analyze", "ta_screen", "ta_chart_read", "ta_market", "ta_alerts", "ta_watchlist", "ta_tasks"]) assert.ok(live.includes(n), n);
+  const sched = names({ taOn: true, writeActions: false });
+  assert.ok(sched.includes("ta_analyze") && !sched.includes("ta_alerts"));
+  for (const t of technical.makeTools()) { assert.equal(t.parameters.type, "object"); assert.ok(t.description.length > 40); }
+});
+
+test("prompt explains the TA tools and keeps them neutral", () => {
+  const p = buildSystemPrompt({ user: { label: "x" }, selected: [], toolNames: ["ta_analyze", "ta_alerts"] });
+  assert.match(p, /GQ Technical Analysis/);
+  assert.match(p, /never say buy, sell or hold/);
+  assert.match(p, /\/ta link/);
+  assert.doesNotMatch(buildSystemPrompt({ user: { label: "x" }, selected: [], toolNames: [] }), /ta_screen/);
+});
+
+test("calls carry the secret and the asker's Telegram id; 403 explains linking", async () => {
+  const seen = [];
+  const fetchImpl = async (url, init) => { seen.push({ url, init }); return url.includes("/api/alerts/rules") ? ok({ error: "not linked" }, 403) : ok({ instrument: { symbol: "TCS" } }); };
+  const ctx = { ta: { url: "https://ta", secret: "s3" }, fetch: fetchImpl, user: { id: "777" } };
+  const a = technical.makeTools().find((t) => t.name === "ta_analyze");
+  assert.equal((await a.run({ symbol: "NSE:TCS" }, ctx)).instrument.symbol, "TCS");
+  assert.equal(seen[0].url, "https://ta/api/stock/NSE%3ATCS");
+  assert.equal(seen[0].init.headers["x-ta-secret"], "s3");
+  assert.equal(seen[0].init.headers["x-telegram-user"], "777");
+  const al = technical.makeTools().find((t) => t.name === "ta_alerts");
+  const r = await al.run({ action: "add", rule: "rsi_cross_above", params: { level: 60 }, timeframe: "W", symbol: "TCS" }, ctx);
+  assert.equal(r.needs_link, true);
+  assert.match(r.how_to_link, /\/ta link/);
+  assert.deepEqual(JSON.parse(seen[1].init.body), { rule: "rsi_cross_above", params: { level: 60 }, tf: "W", instrument: "TCS", source: "telegram" });
+  // the bot's own scheduled runs ("brief") never claim to be a user
+  await a.run({ symbol: "X" }, { ...ctx, user: { id: "brief" } });
+  assert.equal(seen[2].init.headers["x-telegram-user"], undefined);
+  // not configured
+  assert.match((await a.run({ symbol: "X" }, { user: { id: "1" } })).error, /not connected/);
+});
+
+test("/ta link posts the code with the Telegram ids", async () => {
+  let body;
+  const r = await technical.link({ url: "https://ta", secret: "s" }, { code: "123456", telegramUserId: 9, chatId: 9, name: "Dee" }, async (u, i) => { body = JSON.parse(i.body); return ok({ ok: true, email: "d@gquants.com" }); });
+  assert.equal(r.email, "d@gquants.com");
+  assert.deepEqual(body, { code: "123456", telegramUserId: "9", chatId: "9", name: "Dee" });
+});
+
+test("web chat secret check is exact and constant-time", () => {
+  assert.equal(secretOk({ taApiSecret: "abc" }, "abc"), true);
+  assert.equal(secretOk({ taApiSecret: "abc" }, "abd"), false);
+  assert.equal(secretOk({ taApiSecret: "abc" }, ""), false);
+  assert.equal(secretOk({ taApiSecret: "" }, ""), false);
+});
