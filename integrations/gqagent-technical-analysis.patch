@@ -0,0 +1,162 @@
+"use strict";
+// GQ Technical Analysis tools. The agent never computes indicators itself: every
+// number comes from the Technical Analysis server (TA_API_URL), which reads the
+// TA engine's stored calculations. Calls carry TA_API_SECRET, plus the asker's
+// Telegram id so "my alerts", "my watchlist" and "my tasks" mean THEIR
+// Technical Analysis account (linked once with /ta link <code>).
+//
+//   read     ta_analyze, ta_chart_read, ta_screen, ta_compare, ta_market,
+//            ta_review, ta_signal_stats, ta_alert_scorecard
+//   personal ta_alerts, ta_watchlist, ta_tasks (live chats, linked users only)
+
+const TFS = ["D", "W", "M"];
+
+async function call(ctx, method, path, body) {
+  const ta = ctx.ta;
+  if (!ta || !ta.url) return { error: "The Technical Analysis app is not connected to this bot (TA_API_URL / TA_API_SECRET)." };
+  const tg = ctx.taTelegramUser !== undefined ? ctx.taTelegramUser : ctx.user && /^\d+$/.test(String(ctx.user.id)) ? String(ctx.user.id) : null;
+  const headers = { "content-type": "application/json", "x-ta-secret": ta.secret };
+  if (tg) headers["x-telegram-user"] = tg;
+  let r;
+  try {
+    r = await (ctx.fetch || fetch)(`${ta.url}${path}`, { method, headers, body: body ? JSON.stringify(body) : undefined, signal: AbortSignal.timeout(60000) });
+  } catch (e) {
+    return { error: `The Technical Analysis server did not answer (${e.name === "TimeoutError" ? "timeout" : e.message}).` };
+  }
+  let j = {};
+  try { j = await r.json(); } catch { /* not JSON */ }
+  if (r.status === 401) return { error: "The Technical Analysis server rejected the agent: TA_API_SECRET differs between the two services." };
+  if (r.status === 403) return { error: j.error || "Not allowed.", needs_link: true, how_to_link: "In the Technical Analysis app open Alerts -> Telegram, press 'Get code', then send this bot: /ta link <code>" };
+  if (!r.ok) return { error: j.error || `Technical Analysis server answered HTTP ${r.status}` };
+  return j;
+}
+const qs = (o) => Object.entries(o).filter(([, v]) => v != null && v !== "").map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join("&");
+
+const RULE_HELP = "rsi_cross_above {level}, rsi_cross_below {level}, macd_bull_cross, macd_bear_cross, price_cross_above_sma {period}, price_cross_below_sma {period}, price_cross_above_ema {period}, price_cross_below_ema {period}, price_above {price}, price_below {price}, golden_cross, death_cross, bb_break_upper, bb_break_lower, new_high_n {bars}, new_low_n {bars}, mma_compression {pct}";
+
+const readTools = [
+  {
+    name: "ta_analyze",
+    description: "Full stored technical analysis of ONE stock, ETF or index from the GQ Technical Analysis software: trend and MMA alignment on daily/weekly/monthly/quarterly/yearly, RSI and RSI of RSI, divergences, MACD, relative strength vs country/sector/region/global, stage, 52-week and all-time-high distance, volume, Weight Watcher, fundamentals, setup score, recent signals with what followed, and links to the charts. Use it for 'analyse X', 'how does X look', 'is X in an uptrend', 'explain X'. If it returns candidates, ask which one.",
+    parameters: { type: "object", properties: { symbol: { type: "string", description: "ticker or company name, e.g. TCS, HDFCBANK, AAPL, 'Infosys'; exchange prefix allowed (NSE:TCS)" } }, required: ["symbol"] },
+    run: (a, ctx) => call(ctx, "GET", `/api/stock/${encodeURIComponent(String(a.symbol).trim())}`),
+  },
+  {
+    name: "ta_chart_read",
+    description: "A plain-English read of a stock's chart: per timeframe the MMA state, squeeze, RSI, MACD, consolidation/breakout, the latest candlestick pattern and the support/resistance levels price has turned at. Use for 'read the chart of X', 'what is the weekly chart saying', 'support and resistance for X'.",
+    parameters: { type: "object", properties: { symbol: { type: "string" }, timeframes: { type: "string", description: "comma list of D,W,M,Q,Y (default D,W)" } }, required: ["symbol"] },
+    run: (a, ctx) => call(ctx, "GET", `/api/chart-read/${encodeURIComponent(String(a.symbol).trim())}?${qs({ tfs: a.timeframes || "D,W" })}`),
