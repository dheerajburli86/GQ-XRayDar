+    parameters: { type: "object", properties: { rule: { type: "string" }, params: { type: "object" }, timeframe: { type: "string", enum: TFS } }, required: ["rule"] },
+    run: (a, ctx) => call(ctx, "GET", `/api/alerts/scorecard?${qs({ rule: a.rule, params: JSON.stringify(a.params || {}), tf: a.timeframe || "D" })}`),
+  },
