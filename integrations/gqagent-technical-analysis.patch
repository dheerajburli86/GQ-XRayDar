+    parameters: { type: "object", properties: { scope: { type: "string", description: "G, R:<region> or C:<country>" } } },
+    run: (a, ctx) => call(ctx, "GET", `/api/market?${qs({ scope: a.scope || "G" })}`),
+  },
+  {
+    name: "ta_review",
+    description: "Review a list of stocks: which are rising (weekly MMA bullish, or weekly uptrend above the 50-day EMA) and which are not, with returns, relative strength and stage. Give symbols, or the name of the asker's watchlist in the Technical Analysis app.",
+    parameters: { type: "object", properties: { symbols: { type: "array", items: { type: "string" } }, watchlist: { type: "string", description: "name of the asker's watchlist in the TA app" }, question: { type: "string" } } },
