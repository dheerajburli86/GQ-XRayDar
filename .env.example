VITE_PAGE_ROWS=1000

# ── Calculation engine (Node, server-side ONLY - never put these in a VITE_ var) ──
# Supabase -> Project settings -> Database -> Connection string (Session pooler)
DATABASE_URL=
# Only for cli/fx-backfill.mjs (historical FX)
FMP_API_KEY=
