# ── Web app (Vite) ─────────────────────────────────────────────────────────────
# Leave both empty to run on the synthetic demo universe.
VITE_SUPABASE_URL=https://xmcvsnollphnsonaupzt.supabase.co
VITE_SUPABASE_ANON_KEY=
# demo | supabase (default: supabase when the two values above are set)
VITE_DATA_SOURCE=
# PostgREST page size; Supabase's default "Max rows" is 1000
VITE_PAGE_ROWS=1000

# ── Calculation engine (Node, server-side ONLY - never put these in a VITE_ var) ──
# Supabase -> Project settings -> Database -> Connection string (Session pooler)
DATABASE_URL=
# Only for cli/fx-backfill.mjs (historical FX)
FMP_API_KEY=

# ── Web app: login, server and agent (optional) ────────────────────────────────
# The TA backend server on Railway (alerts on Telegram, tasks, GQ agent, sync)
VITE_TA_SERVER_URL=
# Login is required whenever live data is shown; set "false" only for local tests
VITE_REQUIRE_LOGIN=
VITE_ALLOWED_EMAIL_DOMAINS=gquants.com

# ── TA server (server/index.mjs on Railway) - server-side ONLY ─────────────────
# DATABASE_URL (above), plus:
SUPABASE_URL=https://xmcvsnollphnsonaupzt.supabase.co
SUPABASE_ANON_KEY=
ALLOWED_EMAIL_DOMAINS=gquants.com
ALLOWED_EMAILS=
ADMIN_EMAILS=
APP_ORIGINS=https://<your-app>.vercel.app,http://localhost:5173
APP_URL=https://<your-app>.vercel.app
# Same long random value on this server and on the GQ agent
TA_API_SECRET=
# The GQ agent's public URL (for the web agent panel); empty = built-in assistant
GQAGENT_URL=
# The GQ agent's bot token: this server only SENDS messages with it
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=GQagent_bot
# Phone pop-ups (optional): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tech@gquants.com
ALERT_POLL_MINUTES=15
MORNING_SUMMARY_IST=09:15
WEEKLY_SUMMARY_IST=sat 09:00
JOBS_ENABLED=true
