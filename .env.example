# ── Web app (Vite) ─────────────────────────────────────────────────────────────
# Leave both empty to run on the synthetic demo universe.
VITE_SUPABASE_URL=https://xmcvsnollphnsonaupzt.supabase.co
VITE_SUPABASE_ANON_KEY=
# demo | supabase (default: supabase when the two values above are set)
